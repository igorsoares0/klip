# Local development points at the Postgres in docker-compose.yml.
# In production this is the Neon connection string.
DATABASE_URL="postgresql://klip:klip@localhost:5432/klip?schema=public"

# Auth.js. Generate the secret with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend. Without a key, emails are printed to the console instead of sent.
RESEND_API_KEY=""
# Until a domain is verified, Resend's sandbox sender only delivers to the
# address on your own Resend account.
EMAIL_FROM="Klip <onboarding@resend.dev>"

# Salt for hashing visitor IPs. Required in production — without it no
# hash is stored at all, because an unsalted one is reversible.
CLICK_IP_SALT=""
